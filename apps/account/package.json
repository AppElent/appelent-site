{
  "name": "@appelent/account",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3481",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.ts",
    "deploy:staging": "node scripts/env.mjs exec staging --only github -- sh -c \"CLOUDFLARE_ENV=staging pnpm build && node scripts/guard-worker.ts appelent-account-staging && pnpm exec wrangler deploy\"",
    "env:check": "node scripts/env.mjs check",
    "env:plan": "node scripts/env.mjs plan",
    "env:apply": "node scripts/env.mjs apply",
    "env:generate": "node scripts/env.mjs generate",
    "env:exec": "node scripts/env.mjs exec"
  },
  "dependencies": {
    "@clerk/localizations": "^4.26.0",
    "@clerk/react": "^6.19.1",
    "@cloudflare/vite-plugin": "^1.70.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.6",
    "convex": "^1.51.0",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  }
}
