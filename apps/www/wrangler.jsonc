{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The appelent.nl public site: a Worker in front of the static build in
  // dist/ (pnpm build). Production is the top-level config and the staging
  // Worker is env.staging (developer-home standards/deployments.md).
  //
  // Production (APP-480 cutover) runs on appelent.nl and www.appelent.nl as
  // zone routes, not custom domains: both hosts already have proxied DNS
  // records (the old Vimexx parked page), which a custom domain would refuse
  // to replace. The Worker answers every request itself and never fetches that
  // origin; www 301s to the apex. The developer-home apex-favicon Worker's
  // more specific icon routes still win until it is retired; it serves the
  // same icons. Only this top-level block may route a production host
  // (scripts/guard-worker.ts, test/wrangler.test.ts).
  "name": "appelent-www",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "appelent.nl/*", "zone_name": "appelent.nl" },
    { "pattern": "www.appelent.nl/*", "zone_name": "appelent.nl" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker decides /, /account, the language switch and 404s.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": { "INDEXING": "on" },
  "observability": { "enabled": true },
  "env": {
    // What a merge to main deploys (.github/workflows/deploy.yml). The custom
    // domain creates only the www-stg.appelent.nl record; apex, MX, SPF and
    // DKIM records are not touched.
    "staging": {
      "name": "appelent-www-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "www-stg.appelent.nl", "custom_domain": true }],
      "vars": { "INDEXING": "off" }
    }
  }
}
